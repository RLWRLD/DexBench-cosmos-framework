# Settings for this machine and you, the same for every DexBench run: copy to examples/dexbench.env (git-ignored)
# and fill in. The DexBench training and serving launchers read it; a variable already set in your shell wins.
# What a run trains on (dataset, camera set, GPUs, base checkpoint) is given to the launch command, not here.

# Hugging Face: models named by Hub id download into HF_HOME once and are reused from there.
HF_TOKEN=                  # for gated repos; leave empty after `hf auth login`
HF_HOME=                   # Hub cache; empty: ~/.cache/huggingface

# Training: where this machine keeps the Wan2.2 VAE file (docs/action_policy_dexbench_rby1_wuji2_posttrain.md)
WAN_VAE_PATH=examples/checkpoints/wan22_vae/Wan2.2_VAE.pth

# Optional: online training logs
WANDB_API_KEY=
